# --- Navigateur + serveur ---------------------------------------------
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Serveur uniquement (ne jamais préfixer par VITE_) ---------------
SUPABASE_SERVICE_ROLE_KEY=
# SasPay > Développeur > Clés API (scope PAYIN ou BOTH). sk_test_… = bac à sable, paiements fictifs ;
# sk_live_… = paiements réels. Le serveur choisit l'environnement d'après la clé.
SASPAY_API_KEY=
# Vercel > Account Settings > Tokens (sert à déployer les portfolios)
DEPLOY_TOKEN=
# Optionnel : ID de l'équipe Vercel qui héberge les portfolios
DEPLOY_TEAM_ID=

# --- Offre de lancement (optionnel) ---------------------------------
# Code qui offre la publication (un portfolio par compte) du jour FROM à 00:00 au jour UNTIL à 23:59 inclus
# (AAAA-MM-JJ, heure du Bénin). Le serveur lit PROMO_*, le site VITE_PROMO_* : mettez les mêmes dates.
# Vide = pas d'offre. Après modification sur Vercel, redéployez.
PROMO_CODE=
PROMO_FROM=
PROMO_UNTIL=
VITE_PROMO_FROM=
VITE_PROMO_UNTIL=
