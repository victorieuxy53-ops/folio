# --- Navigateur + serveur ---------------------------------------------
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Kkiapay > Développeurs > Clés API. SANDBOX=true avec les clés de test, false avec les clés réelles.
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_SANDBOX=true

# --- Serveur uniquement (ne jamais préfixer par VITE_) ---------------
SUPABASE_SERVICE_ROLE_KEY=
# Kkiapay : clés privée et secrète, du même mode que la clé publique
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# Vercel > Account Settings > Tokens (sert à déployer les portfolios)
DEPLOY_TOKEN=
# Optionnel : ID de l'équipe Vercel qui héberge les portfolios
DEPLOY_TEAM_ID=

# --- Offre de lancement (optionnel) ---------------------------------
# Code qui offre la publication (un portfolio par compte), jusqu'au jour indiqué inclus (AAAA-MM-JJ, heure du Bénin).
# Vide = pas d'offre. Après modification sur Vercel, redéployez.
PROMO_CODE=
VITE_PROMO_UNTIL=
